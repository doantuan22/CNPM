  TAI_KHOAN_YEU_CAU_HO_TRO_MaTaiKhoanKhachHangToTAI_KHOAN TAI_KHOAN  @relation("YEU_CAU_HO_TRO_MaTaiKhoanKhachHangToTAI_KHOAN", fields: [MaTaiKhoanKhachHang], references: [MaTaiKhoan], onUpdate: NoAction, map: "FK_YEU_CAU_HO_TRO_TAI_KHOAN_KhachHang")
  TAI_KHOAN_YEU_CAU_HO_TRO_MaTaiKhoanXuLyToTAI_KHOAN      TAI_KHOAN? @relation("YEU_CAU_HO_TRO_MaTaiKhoanXuLyToTAI_KHOAN", fields: [MaTaiKhoanXuLy], references: [MaTaiKhoan], onDelete: NoAction, onUpdate: NoAction, map: "FK_YEU_CAU_HO_TRO_TAI_KHOAN_XuLy")
