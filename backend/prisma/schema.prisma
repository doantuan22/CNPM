  GioiTinh                                                     String?          @db.NVarChar(20)
  AnhDaiDien                                                   String?          @db.NVarChar(500)
  TrangThai                                                    String           @db.NVarChar(30)
  NgayTao                                                      DateTime
  NgayCapNhat                                                  DateTime
  DANH_GIA                                                     DANH_GIA[]
  DAT_PHONG                                                    DAT_PHONG[]
  HO_SO_DOI_TAC_HO_SO_DOI_TAC_MaTaiKhoanToTAI_KHOAN            HO_SO_DOI_TAC[]  @relation("HO_SO_DOI_TAC_MaTaiKhoanToTAI_KHOAN")
  HO_SO_DOI_TAC_HO_SO_DOI_TAC_MaTaiKhoanDuyetToTAI_KHOAN       HO_SO_DOI_TAC[]  @relation("HO_SO_DOI_TAC_MaTaiKhoanDuyetToTAI_KHOAN")
  KHACH_SAN_KHACH_SAN_MaTaiKhoanDuyetToTAI_KHOAN               KHACH_SAN[]      @relation("KHACH_SAN_MaTaiKhoanDuyetToTAI_KHOAN")
  KHACH_SAN_KHACH_SAN_MaTaiKhoanSoHuuToTAI_KHOAN               KHACH_SAN[]      @relation("KHACH_SAN_MaTaiKhoanSoHuuToTAI_KHOAN")
  VAI_TRO                                                      VAI_TRO          @relation(fields: [MaVaiTro], references: [MaVaiTro], onUpdate: NoAction, map: "FK_TAI_KHOAN_VAI_TRO")
  YEU_CAU_HO_TRO_YEU_CAU_HO_TRO_MaTaiKhoanKhachHangToTAI_KHOAN YEU_CAU_HO_TRO[] @relation("YEU_CAU_HO_TRO_MaTaiKhoanKhachHangToTAI_KHOAN")
  YEU_CAU_HO_TRO_YEU_CAU_HO_TRO_MaTaiKhoanXuLyToTAI_KHOAN      YEU_CAU_HO_TRO[] @relation("YEU_CAU_HO_TRO_MaTaiKhoanXuLyToTAI_KHOAN")
}

model THANH_TOAN {
  MaThanhToan         Int         @id(map: "PK_THANH_TOAN") @default(autoincrement())
